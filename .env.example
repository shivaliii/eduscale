# ==========================================
# EduScale Environment Configuration
# ==========================================
# Copy this file to .env and fill in values

# Database
DATABASE_URL=postgresql://eduscale:eduscale_pass@localhost:5432/eduscale
DATABASE_ECHO=false

# Authentication
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# ML Models
MODEL_DIR=ml/artifacts
DEMO_MODE=true

# Cloud (optional - not required for local development)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# AI Notes Provider (optional)
# OPENAI_API_KEY=
# AI_NOTES_PROVIDER=none

# Experiment Settings
EXPERIMENT_MAX_DURATION_SECONDS=3600
WORKLOAD_SIM_DEFAULT_SEED=42
